        {
            _ = MessageService.ShowAsync("PDFファイルのみ選択できます。", MessageType.Warn);
            return;
        }
        try
        {
            await MessageService.ShowLoadingAsync("ファイル読み込み中...");
            await PdfDataService.HandleFileInputAsync(e, null);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Compress file input error: {ex.Message}");
            _ = MessageService.ShowAsync("ファイルの読み込み中にエラーが発生しました。", MessageType.Error);
        }
        finally
        {
            await MessageService.HideLoadingAsync();
        }
    }

    [JSInvokable]
    public async Task OnJsFileDropped(string fileName, string contentType, string base64Data)
    {
