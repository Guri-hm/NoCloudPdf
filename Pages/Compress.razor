    private async Task ShowResultAsync(CompressResult res)
    {
        await RevokeResultAsync();
        resultFileName = $"{Path.GetFileNameWithoutExtension(file!.FileName)}_compressed.pdf";
        _renderedResult = false;
        result = res;
    }

    private async Task RevokeResultAsync()
    {
        var url = result?.url;
        result = null;
        if (!string.IsNullOrEmpty(url))
        {
            try { await JSRuntime.InvokeVoidAsync("revokeObjectUrl", url); } catch { }
        }
    }

    private async Task BackToSettingsAsync()
    {
        await RevokeResultAsync();
    }

    private async Task DownloadResultAsync()
    {
        if (result?.url == null) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("downloadFileFromUrl", result.url, resultFileName, "application/pdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Compress download error: {ex.Message}");
            _ = MessageService.ShowAsync("PDFのダウンロードに失敗しました。", MessageType.Error);
        }
    }

    private async Task ResetStateAsync()
    {
        await RevokeResultAsync();
        try { await JSRuntime.InvokeVoidAsync("pdfCompress.close"); } catch { }
        file = null;
        analysis = null;
        estimates = null;
        rasterPrompt = null;
    }

    private async Task StartNewAsync()
    {
        await ResetStateAsync();
        PdfDataService.Clear();
    }

