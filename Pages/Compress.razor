                _ = MessageService.ShowAsync("PDFファイルのみ対応しています。", MessageType.Warn);
                return;
            }
            await PdfDataService.HandleDroppedFileAsync(fileName, base64Data);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Compress drop error: {ex.Message}");
            _ = MessageService.ShowAsync("ファイルの読み込み中にエラーが発生しました。", MessageType.Error);
        }
        finally
        {
            await MessageService.HideLoadingAsync();
        }
    }

    private static bool IsPdf(string name) =>
        string.Equals(Path.GetExtension(name), ".pdf", StringComparison.OrdinalIgnoreCase);

    private Task<string?> ShowPasswordInputDialogAsync(string fileName)
    {
        passwordDialogFileName = fileName;
        isPasswordDialogOpen = true;
        passwordTcs = new TaskCompletionSource<string?>();
        StateHasChanged();
        return passwordTcs.Task;
    }

    private void OnPasswordDialogClose(string? password)
    {
        isPasswordDialogOpen = false;
        passwordTcs?.SetResult(password);
        passwordTcs = null;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var showSelectPanel = result == null && file == null && !isOpening && files.Count == 0;
        if (showSelectPanel && !_dropAreaRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("registerSelectDropArea", _dotNetRef);
            _dropAreaRegistered = true;
        }
        else if (!showSelectPanel && _dropAreaRegistered)
        {
            await JSRuntime.InvokeVoidAsync("unregisterSelectDropArea");
            _dropAreaRegistered = false;
        }

        if (result?.url != null && analysis != null && !_renderedResult)
        {
            _renderedResult = true;
            var canvasIds = Enumerable.Range(0, analysis.pageCount).Select(i => $"merged-canvas-{i}").ToArray();
            await JSRuntime.InvokeVoidAsync("renderPdfPages", result.url, canvasIds);
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{bytes / 1024.0 / 1024.0:0.##} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }

    public async ValueTask DisposeAsync()
    {
        PdfDataService.OnChange -= OnServiceChanged;
        PdfDataService.PasswordInputDialogFunc = null;
        passwordTcs?.TrySetCanceled();

        try { await JSRuntime.InvokeVoidAsync("unregisterSelectDropArea"); } catch { }
        try { await JSRuntime.InvokeVoidAsync("pdfCompress.close"); } catch { }
        var url = result?.url;
        if (!string.IsNullOrEmpty(url))
        {
            try { await JSRuntime.InvokeVoidAsync("revokeObjectUrl", url); } catch { }
        }
        _dotNetRef?.Dispose();
    }
